var prompt = require('prompt-sync')();
function min_max(a, b) {
    if (a > b) {
        return "superieure num is " + a;
    }
    else if (a < b) {
        return "inferieure num is " + a;
    }
    else
        return "equale";
}
let num1 = parseInt(prompt("entrez un nombre: "));
let num2 = parseInt(prompt("entrez un nombre: "));
console.log(`${min_max(num1, num2)}`);
